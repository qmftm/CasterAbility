# ─────────────────────────────────────────────────────────
#  악마의 부츠 (B등급) — AbilityWar 이식
#
#  패시브 "지옥의 발자국"
#    신속 효과를 받고, 지나간 자리에 불이 붙습니다.
#    화염·용암 피해를 받지 않습니다.
#    물에 닿으면 축축해져서 그동안은 불이 붙지 않고 신속도 끊깁니다.
# ─────────────────────────────────────────────────────────

options:
    speed_level: 2
    wet_seconds: 4
    trail_max: 20


on load:
    set the name of status effect "devil_wet" to "&b축축함"

    ability class "devilboots":
        name: "악마의 부츠"
        tier: 3
        description:
            "&d[&7패시브 &f- &d지옥의 발자국]"
            "&b신속 2&f 효과를 받고, 지나가는 자리마다"
            "&c불&f이 붙습니다. 최근 &c20칸&f만 남고 뒤는 꺼집니다."
            "&c화염&f과 &6용암&f 피해를 받지 않습니다."
            ""
            "&f물에 닿으면 &b축축함&f이 &c4초&f간 걸립니다."
            "&b축축함&f 중에는 불이 붙지 않고 신속도 사라집니다."

    ability "devilboots_trail":
        class: "devilboots"
        name: "지옥의 발자국"
        trigger: passive
        passive_interval: 5


# ── 패시브: 불 자국과 신속 ────────────────────────────────

on ability use "devilboots_trail":
    # 물에 서 있으면 축축함을 새로 채운다
    if block at player is water:
        refresh status effect "devil_wet" on player for {@wet_seconds} seconds
        stop

    # 축축한 동안에는 아무것도 하지 않는다
    if player has status effect "devil_wet":
        stop

    apply speed {@speed_level} to player for 2 seconds

    set {_loc} to location of player
    block at {_loc} is air
    block below {_loc} is not air

    set block at {_loc} to fire

    # 자국은 사람마다 따로 셉니다. 한 목록을 같이 쓰면 악마의 부츠가 둘일 때
    # 서로의 불을 꺼버립니다.
    set {_id} to player's uuid
    add {_loc} to {devilboots.fire::%{_id}%::*}

    # 자국이 너무 길어지면 가장 오래된 것부터 끈다
    if size of {devilboots.fire::%{_id}%::*} > {@trail_max}:
        set {_old} to first element of {devilboots.fire::%{_id}%::*}
        if block at {_old} is fire:
            set block at {_old} to air
        remove {_old} from {devilboots.fire::%{_id}%::*}


# ── 화염·용암 피해 면역 ───────────────────────────────────

on damage:
    victim has ability class "devilboots"
    # Skript에서 FIRE_TICK(불에 타는 중)은 "burning" 입니다
    damage cause is fire or burning or lava
    cancel event


# ── 게임이 끝나면 남은 불을 끈다 ──────────────────────────

# loop 안에서 또 loop 를 돌면 loop-value 가 어느 쪽인지 헷갈리므로
# 불 끄는 일은 함수로 빼둡니다.

function devilbootsExtinguish(p: player):
    loop {devilboots.fire::%{_p}'s uuid%::*}:
        if block at loop-value is fire:
            set block at loop-value to air

on game end:
    loop all players:
        devilbootsExtinguish(loop-player)
    delete {devilboots.fire::*}
